+
+// *Craft's origin-local library passes real font bytes to the native text engine.
+#[wasm_bindgen::prelude::wasm_bindgen(
+    inline_js = "export function craft_font_take(){return globalThis.CraftFonts?.take() || [];} export function craft_font_ack(id,ok,message){globalThis.CraftFonts?.ack(id,ok,message);} export function craft_font_wake(callback){globalThis.addEventListener('craft:font-change',callback);}"
+)]
+extern "C" {
+    fn craft_font_take() -> js_sys::Array;
+    fn craft_font_ack(id: &str, ok: bool, message: &str);
+    fn craft_font_wake(callback: &js_sys::Function);
+}
+fn suite_font_wake(ctx: egui::Context) {
+    let callback = wasm_bindgen::closure::Closure::<dyn FnMut()>::new(move || ctx.request_repaint());
+    craft_font_wake(callback.as_ref().unchecked_ref());
+    callback.forget(); // One wake listener per app runner, for the lifetime of its page.
+}
+fn suite_font_batch() -> Vec<(String, String, String, Vec<u8>)> {
+    craft_font_take()
+        .iter()
+        .filter_map(|r| {
+            let get = |key: &str| js_sys::Reflect::get(&r, &key.into()).ok();
+            let id = get("id")?.as_string()?;
+            let family = get("family")?.as_string()?;
+            let style = get("style")?.as_string()?;
+            let bytes = js_sys::Uint8Array::new(&get("bytes")?);
+            if bytes.length() > 24 * 1024 * 1024 || id.len() != 64 || family.len() > 160 {
+                return None;
+            }
+            Some((id, family, style, bytes.to_vec()))
+        })
+        .collect()
+}
