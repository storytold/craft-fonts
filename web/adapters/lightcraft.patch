+#[derive(Clone)]
+pub struct RuntimeFont {
+    pub id: String,
+    pub label: String,
+    pub bytes: std::sync::Arc<Vec<u8>>,
+}
+static RUNTIME: std::sync::Mutex<Vec<RuntimeFont>> = std::sync::Mutex::new(Vec::new());
+pub fn runtime_fonts() -> Vec<RuntimeFont> {
+    RUNTIME.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone()
+}
+pub fn runtime_font(id: &str) -> Option<RuntimeFont> {
+    runtime_fonts().into_iter().find(|f| f.id == id)
+}
+pub fn install_runtime(id: String, label: String, bytes: Vec<u8>) -> bool {
+    if bytes.len() > 24 * 1024 * 1024 || id.len() != 64 || label.len() > 320 || ab_glyph::FontRef::try_from_slice(&bytes).is_err() {
+        return false;
+    }
+    let mut fonts = RUNTIME.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    if fonts.iter().any(|f| f.id == id) {
+        return true;
+    }
+    if fonts.iter().map(|f| f.bytes.len()).sum::<usize>() + bytes.len() > 128 * 1024 * 1024 {
+        return false;
+    }
+    fonts.push(RuntimeFont { id, label, bytes: std::sync::Arc::new(bytes) });
+    true
+}
