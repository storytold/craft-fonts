+mod suite_fonts {
+    use wasm_bindgen::JsCast as _;
+    // *Craft's origin-local library passes real font bytes to the native text engine.
+    #[wasm_bindgen::prelude::wasm_bindgen(
+        inline_js = "export function craft_font_take(){return globalThis.CraftFonts?.take() || [];} export function craft_font_ack(id,ok,message){globalThis.CraftFonts?.ack(id,ok,message);} export function craft_font_wake(callback){globalThis.addEventListener('craft:font-change',callback);}"
+    )]
+    extern "C" {
+        fn craft_font_take() -> js_sys::Array;
+        fn craft_font_ack(id: &str, ok: bool, message: &str);
+        fn craft_font_wake(callback: &js_sys::Function);
+    }
+    pub fn suite_font_wake(ctx: egui::Context) {
+        let callback = wasm_bindgen::closure::Closure::<dyn FnMut()>::new(move || ctx.request_repaint());
+        craft_font_wake(callback.as_ref().unchecked_ref());
+        callback.forget(); // One wake listener per app runner, for the lifetime of its page.
+    }
+    fn suite_font_batch() -> Vec<(String, String, String, Vec<u8>)> {
+        craft_font_take()
+            .iter()
+            .filter_map(|r| {
+                let get = |key: &str| js_sys::Reflect::get(&r, &key.into()).ok();
+                let id = get("id")?.as_string()?;
+                let family = get("family")?.as_string()?;
+                let style = get("style")?.as_string()?;
+                let bytes = js_sys::Uint8Array::new(&get("bytes")?);
+                if bytes.length() > 24 * 1024 * 1024 || id.len() != 64 || family.len() > 160 {
+                    return None;
+                }
+                Some((id, family, style, bytes.to_vec()))
+            })
+            .collect()
+    }
+
+    pub struct SuiteApp(pub pdfcraft_ui_egui::PdfCraftApp);
+    impl eframe::App for SuiteApp {
+        fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+            self.0.raw_input_hook(ctx, raw);
+        }
+        fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+            self.0.logic(ctx, frame);
+        }
+        fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+            for (id, family, style, bytes) in suite_font_batch() {
+                let preview_bytes = bytes.clone();
+                let ok = pdfcraft_fonts::runtime::install(id.clone(), format!("{family} · {style}"), bytes);
+                if ok {
+                    use egui::epaint::text::{FontInsert, FontPriority, InsertFontFamily};
+                    ui.ctx().add_font(FontInsert {
+                        name: id.clone(),
+                        data: egui::FontData::from_owned(preview_bytes),
+                        families: vec![InsertFontFamily { family: egui::FontFamily::Name(id.clone().into()), priority: FontPriority::Highest }],
+                    });
+                }
+                craft_font_ack(&id, ok, if ok { "Registered for added PDF text" } else { "Unsupported font" });
+            }
+            self.0.ui(ui, frame);
+        }
+        fn save(&mut self, storage: &mut dyn eframe::Storage) {
+            self.0.save(storage);
+        }
+    }
+}
